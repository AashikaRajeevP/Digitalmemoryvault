# Copy this file to .env and fill in real values locally.
# Never commit .env or real credentials.

SECRET_KEY=
# Leave blank to use the local SQLite database.
DATABASE_URL=

# Optional. For Vercel, use the Upstash Redis TLS URL:
# rediss://default:password@host:port
# Do not use the Upstash REST https:// URL. Leave blank for in-memory storage.
RATELIMIT_STORAGE_URI=

# Security settings
PASSWORD_MIN_LENGTH=12
SESSION_COOKIE_SECURE=0
