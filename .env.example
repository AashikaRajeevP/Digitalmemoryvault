# Copy this file to .env and fill in real values locally.
# Never commit .env or real credentials.

SECRET_KEY=
# Leave blank to use the local SQLite database.
DATABASE_URL=

# Optional. For Vercel, use the Upstash Redis TLS URL:
# rediss://default:password@host:port
# Do not use the Upstash REST https:// URL. Leave blank for in-memory storage.
RATELIMIT_STORAGE_URI=

# Security settings
PASSWORD_MIN_LENGTH=12
SESSION_COOKIE_SECURE=0

# Signup email verification (OTP)
# Dedicated secret used to HMAC the one-time codes. Falls back to SECRET_KEY
# when left blank, but a separate value is recommended.
OTP_SECRET=
# Code lifetime in seconds (minimum 60).
OTP_TTL_SECONDS=300
# Incorrect attempts allowed before a challenge is invalidated.
OTP_MAX_ATTEMPTS=5
# Seconds a user must wait before requesting a new code.
OTP_RESEND_COOLDOWN_SECONDS=60

# Resend (email delivery)
# onboarding@resend.dev only delivers to the Resend account owner's address,
# so it is for testing only. Production requires a verified sender domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
# Set to 1/true/yes to actually send email. Leave 0 to disable delivery.
RESEND_ENABLED=0

# Cloudinary (photo attachments)
# Obtain these from your Cloudinary Dashboard (https://cloudinary.com/console).
# If left blank, photo uploads are disabled gracefully in the UI and memories
# can still be created without photos.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional root folder in Cloudinary for uploaded photos. Defaults to "memoryvault".
CLOUDINARY_UPLOAD_FOLDER=memoryvault
# Photo attachment limits per memory
MAX_PHOTOS_PER_MEMORY=10
# Maximum file size per photo in bytes (default: 10485760 = 10 MB).
MAX_PHOTO_BYTES=10485760

